<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User-level LaunchAgent for the moviecal host telemetry sampler (MOV-494).

  TEMPLATE: replace __NODE_PATH__ (absolute path to node), __REPO_PATH__ and
  __HOME__ when installing. A HUMAN installs this, never a worker. Install,
  removal and stopgap-monitor removal commands are in
  docs/operators/local-execution.md §Host telemetry sampler.

  Starts at login (user LaunchAgent), not at boot. No admin rights.
  mkdir -p __HOME__/Library/Logs/moviecal-telemetry first; launchd will not.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moviecal.telemetry</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__REPO_PATH__/tools/host-telemetry/bin/sampler.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>Nice</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/moviecal-telemetry/sampler.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/moviecal-telemetry/sampler.stderr.log</string>
</dict>
</plist>
